# Copy to .env.local and fill in. Never commit real values.

# The runtime: ZonicAgentRuntimeBackend_Python_LangGraph (deployed dev: https://d2mqmloek8azsa.cloudfront.net).
RUNTIME_API_URL=https://d2mqmloek8azsa.cloudfront.net

# Auth.js: cookie encryption secret (generate with `npx auth secret`) and the OIDC client.
# Decision Q1: the Cognito user pool strands-visual-builder-users-docker for local and CI tests.
# The app client must allow the callback <origin>/api/auth/callback/tripleq (decision UD-3), here http://localhost:3001/api/auth/callback/tripleq.
AUTH_SECRET=
AUTH_TRUST_HOST=true
AUTH_OIDC_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_lDBxGGZYh
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=
AUTH_OIDC_SCOPE=openid email profile

# Feature flags exposed to the browser.
NEXT_PUBLIC_FEATURE_ATTACHMENTS=false
