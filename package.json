{
  "name": "zonic-agent-runtime-ui-langgraph",
  "version": "0.1.0",
  "private": true,
  "description": "Zonic Agent Runtime UI for the LangGraph runtime: catalog, chat with streaming, runs and interrupts",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "sync:contract": "node scripts/sync-contract.mjs",
    "gen:api": "node scripts/gen-api.mjs",
    "gen:api:check": "node scripts/gen-api.mjs --check"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.5",
    "ag-grid-community": "36.2.0",
    "ag-grid-react": "36.2.0",
    "clsx": "2.1.1",
    "echarts": "6.1.0",
    "next": "15.5.28",
    "next-auth": "5.0.0-beta.32",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.6.1",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "jsdom": "25.0.1",
    "json-schema-to-typescript": "15.0.4",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.31",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
